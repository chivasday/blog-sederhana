<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= post ? 'Edit' : 'Post Baru' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <a href="/" class="back">← Kembali</a>
    <h1><%= post ? '✏️ Edit Post' : '📝 Tulis Post Baru' %></h1>
    
    <div class="tips">
      💡 <strong>Tips Markdown:</strong>
      <code># Heading</code> • 
      <code>**bold**</code> • 
      <code>*italic*</code> • 
      <code>\`code\`</code> • 
      <code>\`\`\`js code block\`\`\`</code>
    </div>

    <form action="<%= post ? '/edit/' + post.id : '/new' %>" method="POST">
      <label>Judul</label>
      <input type="text" name="title" placeholder="Judul post..." required 
             value="<%= post ? post.title : '' %>">
      
      <div class="form-row">
        <div class="form-col">
          <label>Kategori</label>
          <select name="category" required>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= post && post.category === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }) %>
          </select>
        </div>
        
        <div class="form-col">
          <label>Tags (pisah koma)</label>
          <input type="text" name="tags" placeholder="nodejs, tutorial, api" 
                 value="<%= post && post.tags ? post.tags.join(', ') : '' %>">
        </div>
      </div>
      
      <label>Thumbnail URL (opsional - kosongin buat auto)</label>
      <input type="url" name="thumbnail" placeholder="https://example.com/image.jpg" 
             value="<%= post ? post.thumbnail : '' %>">
      
      <label>Konten (Markdown)</label>
      <textarea name="content" placeholder="Tulis pake Markdown..." 
                rows="20" required><%= post ? post.content : '' %></textarea>
      
      <button type="submit" class="btn">💾 <%= post ? 'Update' : 'Publish' %></button>
    </form>
  </div>
</body>
</html>
