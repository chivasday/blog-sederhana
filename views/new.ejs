<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Post Baru</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <a href="/" class="back">← Kembali</a>
    <h1>Tulis Post Baru</h1>
    <form action="/new" method="POST">
      <input type="text" name="title" placeholder="Judul" required>
      <textarea name="content" placeholder="Isi post..." rows="10" required></textarea>
      <button type="submit" class="btn">Publish</button>
    </form>
  </div>
</body>
</html>
